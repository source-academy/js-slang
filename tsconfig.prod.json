{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "skipLibCheck": true
  },
  // Excludes are overwritten when using extends, so we
  // list all the excludes again
  "exclude": [
    "node_modules",
    "dist",
    "sicp_publish",
    "src/**/__tests__/**",
    "src/**/__mocks__/**",
    "src/utils/testing",
    // Conductor is ESM-only; this project emits CommonJS. The conductor sources are
    // bundled separately by rollup.config.evaluator.mjs and must not reach the published dist/.
    "src/conductor",
    "vitest.config.ts"
  ]
}
